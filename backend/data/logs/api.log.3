{"timestamp": "2026-08-31T14:46:04.723516+00:00", "level": "INFO", "logger": "sqlalchemy.engine.Engine", "message": "SELECT episode_watch_events.id, shows.id AS id_1, shows.tmdb_id, shows.tvdb_id, shows.imdb_id, shows.title, shows.original_title, shows.overview, shows.tagline, shows.first_air_date, shows.last_air_date, shows.tmdb_poster_path, shows.tmdb_backdrop_path, shows.local_poster_path, shows.local_backdrop_path, shows.homepage_url, shows.original_language, shows.status, shows.show_type, shows.in_production, shows.number_of_seasons, shows.number_of_episodes, shows.episode_run_time, shows.popularity, shows.vote_average, shows.vote_count, shows.metadata_language, shows.metadata_updated_at, shows.created_at, shows.updated_at, seasons.season_number, episode_watch_events.watched_at, episodes.id AS id_2, episodes.season_id, episodes.tmdb_id AS tmdb_id_1, episodes.episode_number, episodes.title AS title_1, episodes.overview AS overview_1, episodes.air_date, episodes.runtime, episodes.vote_average AS vote_average_1, episodes.vote_count AS vote_count_1, episodes.tmdb_still_path, episodes.local_still_path, episodes.created_at AS created_at_1, episodes.updated_at AS updated_at_1 \nFROM episode_watch_events JOIN episodes ON episodes.id = episode_watch_events.episode_id JOIN seasons ON seasons.id = episodes.season_id JOIN shows ON shows.id = seasons.show_id \nWHERE episode_watch_events.user_id = ? AND seasons.season_number > ? ORDER BY episode_watch_events.watched_at DESC, episode_watch_events.id DESC\n LIMIT ? OFFSET ?"}
{"timestamp": "2026-08-31T14:46:04.726663+00:00", "level": "INFO", "logger": "sqlalchemy.engine.Engine", "message": "SELECT library_entries.id, library_entries.status, shows.id AS id_1, shows.tmdb_id, shows.tvdb_id, shows.imdb_id, shows.title, shows.original_title, shows.overview, shows.tagline, shows.first_air_date, shows.last_air_date, shows.tmdb_poster_path, shows.tmdb_backdrop_path, shows.local_poster_path, shows.local_backdrop_path, shows.homepage_url, shows.original_language, shows.status AS status_1, shows.show_type, shows.in_production, shows.number_of_seasons, shows.number_of_episodes, shows.episode_run_time, shows.popularity, shows.vote_average, shows.vote_count, shows.metadata_language, shows.metadata_updated_at, shows.created_at, shows.updated_at, seasons.season_number, episodes.id AS id_2, episodes.season_id, episodes.tmdb_id AS tmdb_id_1, episodes.episode_number, episodes.title AS title_1, episodes.overview AS overview_1, episodes.air_date, episodes.runtime, episodes.vote_average AS vote_average_1, episodes.vote_count AS vote_count_1, episodes.tmdb_still_path, episodes.local_still_path, episodes.created_at AS created_at_1, episodes.updated_at AS updated_at_1 \nFROM library_entries JOIN shows ON shows.id = library_entries.show_id JOIN seasons ON seasons.show_id = shows.id JOIN episodes ON episodes.season_id = seasons.id \nWHERE library_entries.user_id = ? AND library_entries.show_id IS NOT NULL AND library_entries.status = ? AND seasons.season_number > ? AND episodes.air_date IS NOT NULL AND episodes.air_date >= ? AND episodes.air_date <= ? AND (episodes.id NOT IN (SELECT episode_progress.episode_id \nFROM episode_progress \nWHERE episode_progress.user_id = ? AND episode_progress.is_watched IS 1)) ORDER BY episodes.air_date DESC, shows.title ASC, seasons.season_number DESC, episodes.episode_number DESC, episodes.id DESC\n LIMIT ? OFFSET ?"}
