{"timestamp": "2026-09-07T05:52:24.686027+00:00", "level": "INFO", "logger": "sqlalchemy.engine.Engine", "message": "SELECT seasons.show_id, count(episode_progress.id) AS count_1 \nFROM episode_progress JOIN episodes ON episodes.id = episode_progress.episode_id JOIN seasons ON seasons.id = episodes.season_id \nWHERE episode_progress.user_id = ? AND episode_progress.is_watched IS 1 AND seasons.show_id IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) AND seasons.season_number > ? AND episodes.air_date IS NOT NULL AND episodes.air_date <= ? GROUP BY seasons.show_id"}
