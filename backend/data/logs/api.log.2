{"timestamp": "2026-08-31T14:29:52.721923+00:00", "level": "INFO", "logger": "sqlalchemy.engine.Engine", "message": "SELECT anon_1.show_id, episodes.id, episodes.season_id, episodes.tmdb_id, episodes.episode_number, episodes.title, episodes.overview, episodes.air_date, episodes.runtime, episodes.vote_average, episodes.vote_count, episodes.tmdb_still_path, episodes.local_still_path, episodes.created_at, episodes.updated_at, anon_1.season_number \nFROM (SELECT seasons.show_id AS show_id, episodes.id AS episode_id, seasons.season_number AS season_number, row_number() OVER (PARTITION BY seasons.show_id ORDER BY seasons.season_number ASC, episodes.episode_number ASC) AS position \nFROM episodes JOIN seasons ON seasons.id = episodes.season_id \nWHERE seasons.show_id IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) AND seasons.season_number > ? AND episodes.air_date IS NOT NULL AND episodes.air_date <= ?) AS anon_1 JOIN episodes ON episodes.id = anon_1.episode_id \nWHERE anon_1.position = ?"}
