{"timestamp": "2026-09-02T04:01:10.972454+00:00", "level": "INFO", "logger": "sqlalchemy.engine.Engine", "message": "SELECT count(movie_watch_events.id) AS count_1, coalesce(sum(movies.runtime), ?) AS coalesce_1 \nFROM movie_watch_events JOIN movies ON movies.id = movie_watch_events.movie_id \nWHERE movie_watch_events.user_id = ? AND movie_watch_events.watched_at >= ? AND movie_watch_events.watched_at < ?"}
