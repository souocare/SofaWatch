{"timestamp": "2026-08-31T14:26:21.897954+00:00", "level": "INFO", "logger": "sqlalchemy.engine.Engine", "message": "SELECT anon_1.show_id, anon_1.season_number, episodes.id, episodes.season_id, episodes.tmdb_id, episodes.episode_number, episodes.title, episodes.overview, episodes.air_date, episodes.runtime, episodes.vote_average, episodes.vote_count, episodes.tmdb_still_path, episodes.local_still_path, episodes.created_at, episodes.updated_at \nFROM (SELECT seasons.show_id AS show_id, episodes.id AS episode_id, seasons.season_number AS season_number, row_number() OVER (PARTITION BY seasons.show_id ORDER BY seasons.season_number ASC, episodes.episode_number ASC) AS row_number \nFROM episodes JOIN seasons ON seasons.id = episodes.season_id \nWHERE seasons.show_id IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) AND seasons.season_number > ? AND episodes.air_date IS NOT NULL AND episodes.air_date <= ? AND (episodes.id NOT IN (SELECT episode_progress.episode_id \nFROM episode_progress \nWHERE episode_progress.user_id = ? AND episode_progress.is_watched IS 1))) AS anon_1 JOIN episodes ON episodes.id = anon_1.episode_id \nWHERE anon_1.row_number = ?"}
