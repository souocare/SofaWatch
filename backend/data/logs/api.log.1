{"timestamp": "2026-09-10T04:24:09.091260+00:00", "level": "INFO", "logger": "sqlalchemy.engine.Engine", "message": "SELECT movie_watch_events.id, movies.id AS id_1, movies.tmdb_id, movies.title, movies.original_title, movies.overview, movies.tagline, movies.release_date, movies.tmdb_poster_path, movies.tmdb_backdrop_path, movies.local_poster_path, movies.local_backdrop_path, movies.original_language, movies.runtime, movies.status, movies.adult, movies.video, movies.popularity, movies.vote_average, movies.vote_count, movies.metadata_language, movies.metadata_updated_at, movies.created_at, movies.updated_at, movie_watch_events.watched_at \nFROM movie_watch_events JOIN movies ON movies.id = movie_watch_events.movie_id \nWHERE movie_watch_events.user_id = ? ORDER BY movie_watch_events.watched_at DESC, movie_watch_events.id DESC\n LIMIT ? OFFSET ?"}
{"timestamp": "2026-09-10T04:24:09.080187+00:00", "level": "INFO", "logger": "sqlalchemy.engine.Engine", "message": "SELECT users.id AS users_id, users.username AS users_username, users.email AS users_email, users.display_name AS users_display_name, users.password_hash AS users_password_hash, users.is_active AS users_is_active, users.is_admin AS users_is_admin, users.created_at AS users_created_at, users.updated_at AS users_updated_at \nFROM users \nWHERE users.id = ?"}
