{"timestamp": "2026-09-09T04:08:44.336353+00:00", "level": "INFO", "logger": "sqlalchemy.engine.Engine", "message": "SELECT movie_watch_events.id, movies.id AS id_1, movies.tmdb_id, movies.title, movies.original_title, movies.overview, movies.tagline, movies.release_date, movies.tmdb_poster_path, movies.tmdb_backdrop_path, movies.local_poster_path, movies.local_backdrop_path, movies.original_language, movies.runtime, movies.status, movies.adult, movies.video, movies.popularity, movies.vote_average, movies.vote_count, movies.metadata_language, movies.metadata_updated_at, movies.created_at, movies.updated_at, movie_watch_events.watched_at \nFROM movie_watch_events JOIN movies ON movies.id = movie_watch_events.movie_id \nWHERE movie_watch_events.user_id = ? ORDER BY movie_watch_events.watched_at DESC, movie_watch_events.id DESC\n LIMIT ? OFFSET ?"}
