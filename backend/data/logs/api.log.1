{"timestamp": "2026-08-28T15:59:17.797767+00:00", "level": "INFO", "logger": "sqlalchemy.engine.Engine", "message": "SELECT anon_1.show_id, anon_1.season_number, anon_1.watched_at, episodes.id, episodes.season_id, episodes.tmdb_id, episodes.episode_number, episodes.title, episodes.overview, episodes.air_date, episodes.runtime, episodes.vote_average, episodes.vote_count, episodes.tmdb_still_path, episodes.local_still_path, episodes.created_at, episodes.updated_at \nFROM (SELECT seasons.show_id AS show_id, episodes.id AS episode_id, seasons.season_number AS season_number, episode_progress.watched_at AS watched_at, row_number() OVER (PARTITION BY seasons.show_id ORDER BY episode_progress.watched_at DESC) AS row_number \nFROM episode_progress JOIN episodes ON episodes.id = episode_progress.episode_id JOIN seasons ON seasons.id = episodes.season_id \nWHERE episode_progress.user_id = ? AND episode_progress.is_watched IS 1 AND episode_progress.watched_at IS NOT NULL AND seasons.show_id IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) AND seasons.season_number > ?) AS anon_1 JOIN episodes ON episodes.id = anon_1.episode_id \nWHERE anon_1.row_number = ?"}
{"timestamp": "2026-08-28T15:59:17.798543+00:00", "level": "INFO", "logger": "sqlalchemy.engine.Engine", "message": "SELECT episode_progress.episode_id \nFROM episode_progress \nWHERE episode_progress.user_id = ? AND episode_progress.episode_id IN (?, ?, ?, ?) AND episode_progress.is_watched IS 1"}
