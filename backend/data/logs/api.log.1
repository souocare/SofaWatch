{"timestamp": "2026-09-09T04:49:03.997398+00:00", "level": "INFO", "logger": "sqlalchemy.engine.Engine", "message": "SELECT library_entries.id, library_entries.user_id, library_entries.show_id, library_entries.movie_id, library_entries.status, library_entries.rating, library_entries.started_at, library_entries.completed_at, library_entries.created_at, library_entries.updated_at, shows_1.id AS id_1, shows_1.tmdb_id, shows_1.tvdb_id, shows_1.imdb_id, shows_1.title, shows_1.original_title, shows_1.overview, shows_1.tagline, shows_1.first_air_date, shows_1.last_air_date, shows_1.tmdb_poster_path, shows_1.tmdb_backdrop_path, shows_1.local_poster_path, shows_1.local_backdrop_path, shows_1.homepage_url, shows_1.original_language, shows_1.status AS status_1, shows_1.show_type, shows_1.in_production, shows_1.number_of_seasons, shows_1.number_of_episodes, shows_1.episode_run_time, shows_1.popularity, shows_1.vote_average, shows_1.vote_count, shows_1.metadata_language, shows_1.metadata_updated_at, shows_1.created_at AS created_at_1, shows_1.updated_at AS updated_at_1 \nFROM library_entries LEFT OUTER JOIN shows AS shows_1 ON shows_1.id = library_entries.show_id \nWHERE library_entries.user_id = ? AND library_entries.show_id IS NOT NULL AND library_entries.status = ? ORDER BY library_entries.updated_at DESC, library_entries.created_at DESC"}
