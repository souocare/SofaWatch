{"timestamp": "2026-08-28T16:49:03.014869+00:00", "level": "INFO", "logger": "sqlalchemy.engine.Engine", "message": "SELECT seasons.show_id, count(episodes.id) AS count_1 \nFROM episodes JOIN seasons ON seasons.id = episodes.season_id \nWHERE seasons.show_id IN (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) AND seasons.season_number > ? AND episodes.air_date IS NOT NULL AND episodes.air_date <= ? GROUP BY seasons.show_id"}
