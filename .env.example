# ==============================================================================
# SofaWatch
# Example environment configuration
# ==============================================================================
#
# Copy this file to .env in the project root:
#
#   cp .env.example .env
#
# Never commit your real .env file.
# Replace all secret placeholders before running SofaWatch.
# ==============================================================================


# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------

SOFAWATCH_APP_NAME=SofaWatch

# Supported application environments currently include:
# development
# production
SOFAWATCH_ENVIRONMENT=development

# Enable only for local development/debugging.
SOFAWATCH_DEBUG=true


# ------------------------------------------------------------------------------
# API
# ------------------------------------------------------------------------------

SOFAWATCH_API_HOST=0.0.0.0
SOFAWATCH_API_PORT=8000


# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------

# SQLite is the intended SofaWatch database.
SOFAWATCH_DATABASE_URL=sqlite:///./data/sofawatch.db


# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------

SOFAWATCH_DATA_STORAGE_PATH=./data
SOFAWATCH_IMAGE_STORAGE_PATH=./data/images


# ------------------------------------------------------------------------------
# Authentication / Security
# ------------------------------------------------------------------------------

# REQUIRED.
#
# Must be at least 32 characters.
# Generate a strong value, for example:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
SOFAWATCH_SECRET_KEY=replace-with-a-long-random-secret

# Short-lived API access token lifetime.
SOFAWATCH_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Persistent authenticated-session idle lifetime.
SOFAWATCH_SESSION_IDLE_EXPIRE_DAYS=180


# ------------------------------------------------------------------------------
# Localization
# ------------------------------------------------------------------------------

SOFAWATCH_DEFAULT_LANGUAGE=en-US

# Comma-separated list.
SOFAWATCH_SUPPORTED_LANGUAGES=en-US,pt-PT


# ------------------------------------------------------------------------------
# TMDB
# ------------------------------------------------------------------------------

# TMDB API Read Access Token.
SOFAWATCH_TMDB_API_TOKEN=

SOFAWATCH_TMDB_BASE_URL=https://api.themoviedb.org/3
SOFAWATCH_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
SOFAWATCH_TMDB_TIMEOUT_SECONDS=20


# ------------------------------------------------------------------------------
# TVDB
# ------------------------------------------------------------------------------
#
# Reserved for the future TVDB integration.
# SofaWatch does not currently use TVDB as an active metadata provider.
# These values may remain empty until TVDB support is implemented.
# ------------------------------------------------------------------------------

SOFAWATCH_TVDB_API_KEY=
SOFAWATCH_TVDB_PIN=
SOFAWATCH_TVDB_BASE_URL=https://api4.thetvdb.com/v4


# ------------------------------------------------------------------------------
# Metadata synchronization
# ------------------------------------------------------------------------------

# Number of days before normally considering metadata stale enough to refresh.
#
# This is different from the Background Job worker check interval.
SOFAWATCH_METADATA_REFRESH_DAYS=7


# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------

# Comma-separated browser origins allowed to access the backend.
#
# Native iOS/Android clients are not governed by browser CORS in the same way.
#
# Add the actual Web frontend origin when configuring a production deployment.
SOFAWATCH_CORS_ORIGINS=
